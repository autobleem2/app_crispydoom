diff --git a/src/i_joystick.c b/src/i_joystick.c
index eb903deb..adf13b07 100644
--- a/src/i_joystick.c
+++ b/src/i_joystick.c
@@ -420,6 +420,24 @@ void I_UpdateGamepad(void)
         axis_values[SDL_CONTROLLER_AXIS_LEFTY] =
             SDL_GameControllerGetAxis(gamepad, SDL_CONTROLLER_AXIS_LEFTY);
 
+        // AutoBleem: the D-pad is the left stick while the stick is centred, so a pad whose D-pad is
+        // all it has (the PlayStation Classic's, on Windows an XInput pad played with the D-pad) moves
+        // and turns in the game, not only in the menus
+        if (abs(axis_values[SDL_CONTROLLER_AXIS_LEFTX]) < 8000)
+        {
+            if (SDL_GameControllerGetButton(gamepad, SDL_CONTROLLER_BUTTON_DPAD_LEFT))
+                axis_values[SDL_CONTROLLER_AXIS_LEFTX] = -32767;
+            else if (SDL_GameControllerGetButton(gamepad, SDL_CONTROLLER_BUTTON_DPAD_RIGHT))
+                axis_values[SDL_CONTROLLER_AXIS_LEFTX] = 32767;
+        }
+        if (abs(axis_values[SDL_CONTROLLER_AXIS_LEFTY]) < 8000)
+        {
+            if (SDL_GameControllerGetButton(gamepad, SDL_CONTROLLER_BUTTON_DPAD_UP))
+                axis_values[SDL_CONTROLLER_AXIS_LEFTY] = -32767;
+            else if (SDL_GameControllerGetButton(gamepad, SDL_CONTROLLER_BUTTON_DPAD_DOWN))
+                axis_values[SDL_CONTROLLER_AXIS_LEFTY] = 32767;
+        }
+
         axis_values[SDL_CONTROLLER_AXIS_RIGHTX] =
             SDL_GameControllerGetAxis(gamepad, SDL_CONTROLLER_AXIS_RIGHTX);
 
